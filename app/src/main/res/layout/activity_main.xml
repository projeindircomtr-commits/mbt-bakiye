<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/kagit" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MBT Bakiye" android:textColor="@color/lacivert"
            android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/kart_bakiye" android:padding="22dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Genel toplam bakiye" android:textColor="#BFC8D6" android:textSize="14sp" />
            <TextView android:id="@+id/txtToplam" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Onay bekleyen gelirler" android:textColor="@color/lacivert"
            android:textSize="16sp" android:textStyle="bold"
            android:layout_marginTop="24dp" android:layout_marginBottom="8dp" />

        <LinearLayout android:id="@+id/liste" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:id="@+id/txtBos" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Bekleyen gelir yok." android:textColor="#6B7686" android:visibility="gone" />

        <TextView android:id="@+id/txtDurum" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#6B7686" android:textSize="13sp" android:layout_marginTop="16dp" />

        <Button android:id="@+id/btnYenile" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Yenile" android:textAllCaps="false" android:textColor="#FFFFFF"
            android:background="@drawable/buton" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
